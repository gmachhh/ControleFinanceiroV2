@using ControleFinanceiro.Models
@model ControleFinanceiro.Models.Transacao

@{
    ViewData["Title"] = "Nova Transação";
}

<div class="page-header">

    <div>
        <h1>Nova transação</h1>

        <p>
            Registre uma nova receita ou despesa.
        </p>
    </div>

</div>

<div class="form-card">

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="mb-3">

            <label asp-for="Descricao"
                   class="form-label">
            </label>

            <input asp-for="Descricao"
                   class="form-control"
                   placeholder="Ex: Salário, Mercado, Uber..." />

            <span asp-validation-for="Descricao"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Valor"
                   class="form-label">
            </label>

            <input asp-for="Valor"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0.01"
                   placeholder="0,00" />

            <span asp-validation-for="Valor"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Data"
                   class="form-label">
            </label>

            <input asp-for="Data"
                   class="form-control"
                   type="date" />

            <span asp-validation-for="Data"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Tipo"
                   class="form-label">
                Tipo
            </label>

            <select asp-for="Tipo"
                    class="form-select">

                <option value="">
                    Selecione o tipo
                </option>

                <option value="@((int)TipoTransacao.Receita)">
                    Receita
                </option>

                <option value="@((int)TipoTransacao.Despesa)">
                    Despesa
                </option>

            </select>

            <span asp-validation-for="Tipo"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="CategoriaId"
                   class="form-label">
                Categoria
            </label>

            <select asp-for="CategoriaId"
                    asp-items="ViewBag.Categorias"
                    class="form-select">

                <option value="">
                    Selecione uma categoria
                </option>

            </select>

            <span asp-validation-for="CategoriaId"
                  class="text-danger">
            </span>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="fa-solid fa-check"></i>

                Salvar transação

            </button>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}