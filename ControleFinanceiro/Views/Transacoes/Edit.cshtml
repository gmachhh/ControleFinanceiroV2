@using ControleFinanceiro.Models
@model ControleFinanceiro.Models.Transacao

@{
    ViewData["Title"] = "Editar Transação";
}

<div class="page-header">

    <div>

        <h1>Editar transação</h1>

        <p>
            Altere as informações da transação.
        </p>

    </div>

</div>

<div class="form-card">

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <!-- DESCRIÇÃO -->

        <div class="mb-3">

            <label asp-for="Descricao"
                   class="form-label">
            </label>

            <input asp-for="Descricao"
                   class="form-control"
                   placeholder="Ex: Salário, Mercado, Uber..." />

            <span asp-validation-for="Descricao"
                  class="text-danger">
            </span>

        </div>


        <!-- VALOR -->

        <div class="mb-3">

            <label asp-for="Valor"
                   class="form-label">
            </label>

            <input asp-for="Valor"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0.01" />

            <span asp-validation-for="Valor"
                  class="text-danger">
            </span>

        </div>


        <!-- DATA -->

        <div class="mb-3">

            <label asp-for="Data"
                   class="form-label">
            </label>

            <input asp-for="Data"
                   class="form-control"
                   type="date" />

            <span asp-validation-for="Data"
                  class="text-danger">
            </span>

        </div>


        <!-- TIPO -->

        <div class="mb-3">

            <label asp-for="Tipo"
                   class="form-label">
                Tipo
            </label>

            <select asp-for="Tipo"
                    class="form-select">

                <option value="@((int)TipoTransacao.Receita)">
                    Receita
                </option>

                <option value="@((int)TipoTransacao.Despesa)">
                    Despesa
                </option>

            </select>

            <span asp-validation-for="Tipo"
                  class="text-danger">
            </span>

        </div>


        <!-- CATEGORIA -->

        <div class="mb-3">

            <label asp-for="CategoriaId"
                   class="form-label">
                Categoria
            </label>

            <select asp-for="CategoriaId"
                    asp-items="ViewBag.Categorias"
                    class="form-select">

                <option value="">
                    Selecione uma categoria
                </option>

            </select>

            <span asp-validation-for="CategoriaId"
                  class="text-danger">
            </span>

        </div>


        <!-- BOTÕES -->

        <div class="form-actions">

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancelar

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="fa-solid fa-check"></i>

                Salvar alterações

            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}