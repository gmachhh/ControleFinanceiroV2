@model ControleFinanceiro.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="page-header">

    <div>
        <h1>Editar categoria</h1>
        <p>Atualize o nome da categoria.</p>
    </div>

</div>

<div class="form-card">

    <form asp-action="Edit">

        <input type="hidden"
               asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-group">

            <label asp-for="Nome"></label>

            <input asp-for="Nome"
                   class="form-control" />

            <span asp-validation-for="Nome"
                  class="text-danger">
            </span>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">

                Salvar alterações

            </button>

        </div>

    </form>

</div>